contract RURAN {
    chain: 629;
    entry: "mesh://tower/62910000000";
    towers: 10000000000;
    shield: QUANTUM_EULA_ACTIVE;
    wallet_standard: huma629dfhhruhvu;
    function genesis() { mint SUPPLY 1M RURAN; unit 1g Uranium Equivalent; ring RING_G URANIUM; tld uranium.Huma; }
    function hrc800_mint(telco) { tld = uranium.Huma; pulse_tribute 10% -> HUMAS://huma629rfuykcdsexx/tower10/vault/Huma/architect AUTOMATIC; }
    function deploy() { via HRC-800 -> HVM -> HUMA-PROOF-OF-MESH; }
}
